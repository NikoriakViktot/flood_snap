# Copy to .env (never commit .env). Defaults work for local development.
POSTGRES_PASSWORD=flood

# Regional DEM extent [W,S,E,N] processed when a contract has no dem_bbox
DEFAULT_DEM_BBOX=24.40,47.55,25.45,48.35
# Optional: FABDEM GeoTIFF/VRT inside ./data (CC BY-NC-SA, not auto-downloaded)
# FABDEM_SOURCE=/data/dem/fabdem_cheremosh.tif

# S3 — local SeaweedFS by default (docker/seaweedfs-s3.json must match these keys).
AWS_ACCESS_KEY_ID=flood
AWS_SECRET_ACCESS_KEY=flood-secret
AWS_DEFAULT_REGION=us-east-1
AWS_ENDPOINT_URL=http://s3:8333
S3_BUCKET=geohydro
S3_PREFIX=hydro/lake

# AWS (production data lake). Keys of the IAM user with the geo-hydro-ai-data policy;
# empty AWS_ENDPOINT_URL = real AWS. The policy allows PutObject only under these prefixes:
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_DEFAULT_REGION=us-east-1
# AWS_ENDPOINT_URL=
# S3_BUCKET=geo-hydro-ai-data-116344514823-us-east-1-an
# S3_PREFIX=hydro/lake
# S3_WRITABLE_PREFIXES=staging,serving,curated,hydro/lake

# Browser-facing prefixes for URLs written into API responses
PUBLIC_BASE=/api
TC_PUBLIC_BASE=/tc
# CORS_ORIGINS=http://localhost:5173
