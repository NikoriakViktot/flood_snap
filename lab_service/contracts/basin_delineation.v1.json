{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "geoproc/basin_delineation.v1",
  "title": "geoproc.basin_delineation task kwargs",
  "description": "Canonical copy: geoai-django contracts/geoproc/basin_delineation.v1.json. Sent by the platform to the queue `geoproc`.",
  "type": "object",
  "required": ["job_id", "params"],
  "additionalProperties": false,
  "properties": {
    "job_id": {"type": "string", "description": "the platform Job id (UUID); also the Celery task id"},
    "params": {
      "type": "object",
      "required": ["outlet_lon", "outlet_lat", "region"],
      "properties": {
        "outlet_lon": {"type": "number", "minimum": -180, "maximum": 180},
        "outlet_lat": {"type": "number", "minimum": -90, "maximum": 90},
        "region": {"type": "string", "description": "river-basin district code, e.g. 5.3.2"},
        "hand_threshold": {"type": "number", "exclusiveMinimum": 0, "maximum": 100},
        "stream_threshold": {"enum": ["low", "medium", "high"]},
        "dem_cog_url": {"type": "string", "pattern": "^national:[a-z_0-9]+$"},
        "project_id": {"type": ["string", "null"]}
      }
    }
  }
}
