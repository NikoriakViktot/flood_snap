# Copy to deploy/server/lab.env on the server (never commit lab.env).
# Same key as the platform's SERVICE_JWT_KEY (geoai-django deploy/server/platform.env).
SERVICE_JWT_KEY=
PLATFORM_REDIS_URL=redis://platform-redis:6379/2
S3_BUCKET=geo-hydro-ai-data-116344514823-us-east-1-an
AWS_DEFAULT_REGION=us-east-1
TERRAIN_PREFIX=hydro/lake/national_terrain/v2
CACHE_ROOT=/data/lab/cache
CACHE_MAX_GB=8
JOBS_ROOT=/data/lab/jobs
CHILD_MEM_GB=2.0
DEMS=fab_dem,copernicus_dem
# HAND models (lab_service/hand): limits of the inline delivery; thread caps keep the pipeline child inside CHILD_MEM_GB
HAND_MAX_BASIN_KM2=2000
HAND_PNG_MAX_PIXELS=4000000
OPENBLAS_NUM_THREADS=1
OMP_NUM_THREADS=1
GDAL_NUM_THREADS=1
# provenance: the image tag this worker runs (deploy sets it)
LAB_IMAGE_TAG=
